# ========== 支付宝电脑网站支付 ==========
# 开放平台 https://open.alipay.com 创建应用并签约「电脑网站支付」
# ALIPAY_SIGN_MODE=key  → 公钥模式（推荐：应用私钥 + 支付宝公钥）
# ALIPAY_SIGN_MODE=cert → 公钥证书模式（应用私钥 + 三份证书）

ALIPAY_APP_ID=2021006129612969
ALIPAY_SANDBOX=false
ALIPAY_SIGN_MODE=key
# true=未配齐密钥时使用 Mock 跳转；密钥就位后改为 false
ALIPAY_MOCK=false

# ---- 公钥模式（key）----
#   certs/alipay/app_private_key.pem     ← 应用私钥
#   certs/alipay/alipay_public_key.pem   ← 开放平台下载的支付宝公钥
ALIPAY_PRIVATE_KEY_PATH=certs/alipay/app_private_key.pem
ALIPAY_PRIVATE_KEY_PASSWORD=
ALIPAY_PUBLIC_KEY_PATH=certs/alipay/alipay_public_key.pem

# ---- 公钥证书模式（cert）----
# ALIPAY_SIGN_MODE=cert
# ALIPAY_APP_CERT_PATH=certs/alipay/appCertPublicKey_2021006129612969.crt
# ALIPAY_PUBLIC_CERT_PATH=certs/alipay/alipayCertPublicKey_RSA2.crt
# ALIPAY_ROOT_CERT_PATH=certs/alipay/alipayRootCert.crt
ALIPAY_APP_CERT_PATH=certs/alipay/appCertPublicKey_2021006129612969.crt
ALIPAY_PUBLIC_CERT_PATH=certs/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=certs/alipay/alipayRootCert.crt

# 也可用环境变量内联内容（优先用上面的 PATH；PATH 为空时才读这些）
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_APP_CERT=
# ALIPAY_PUBLIC_CERT=
# ALIPAY_ROOT_CERT=

ALIPAY_NOTIFY_URL=https://city-index.cn/dashboard/api/alipay/notify/
ALIPAY_RETURN_URL=https://city-index.cn/landing/pricing/?pay=return
ORDER_PAY_TIMEOUT_MINUTES=30

# Mock 联调（ALIPAY_MOCK=true）时，支付成功可 POST：
#   /dashboard/api/alipay/mock-notify/
#   Body: {"order_no": "ORD..."}

# ========== 微信支付 Native（扫码） ==========
# 商户平台 https://pay.weixin.qq.com 开通「Native支付」
# 需要：AppID、商户号、APIv3密钥、商户API证书序列号、apiclient_key.pem
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=certs/wechat/apiclient_key.pem
WECHAT_CERT_DIR=certs/wechat
# true=未配齐参数时使用 Mock 二维码；密钥就位后改为 false
WECHAT_MOCK=true
WECHAT_NOTIFY_URL=https://city-index.cn/dashboard/api/wechat/notify/

# Mock 联调（WECHAT_MOCK=true）时，支付成功可 POST：
#   /dashboard/api/wechat/mock-notify/
#   Body: {"order_no": "ORD..."}

# ========== 企查查企业二要素核验（机构用户认证） ==========
# 开放平台 https://openapi.qcc.com/dataApi/855 申请开通 ApiCode 855
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
# true=未配置密钥时 Mock；正式环境改为 false 并填写密钥
# Mock 下信用代码以 MOCK 开头 + 任意单位名称可核验通过
QICHACHA_MOCK=true
