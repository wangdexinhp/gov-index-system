# ========== 支付宝当面付（沙箱） ==========
# 开放平台 https://open.alipay.com 创建应用并签约「当面付」
# 沙箱网关会自动启用（ALIPAY_SANDBOX=true）

ALIPAY_APP_ID=mock_sandbox_app_id
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
# true=未配置密钥时使用 Mock 二维码；配置真实沙箱密钥后改为 false
ALIPAY_MOCK=true

ALIPAY_NOTIFY_URL=https://city-index.cn/dashboard/api/alipay/notify/
ALIPAY_RETURN_URL=https://city-index.cn/landing/pricing/?pay=return
ORDER_PAY_TIMEOUT_MINUTES=30

# Mock 联调（ALIPAY_MOCK=true）时，支付成功可 POST：
#   /dashboard/api/alipay/mock-notify/
#   Body: {"order_no": "ORD..."}
