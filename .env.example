# ========== 支付宝当面付（公钥证书模式） ==========
# 开放平台 https://open.alipay.com 创建应用并签约「当面付」
# 加签方式选择「公钥证书」，下载 3 个证书 + 本地保管应用私钥

ALIPAY_APP_ID=mock_sandbox_app_id
ALIPAY_SANDBOX=true
# true=未配齐证书时使用 Mock 二维码；证书就位后改为 false
ALIPAY_MOCK=true

# 推荐：把文件放到 certs/alipay/（文件名可改，同步改路径）
#   certs/alipay/app_private_key.pem          ← 密钥工具生成的应用私钥
#   certs/alipay/appCertPublicKey.crt         ← 应用公钥证书
#   certs/alipay/alipayCertPublicKey_RSA2.crt ← 支付宝公钥证书
#   certs/alipay/alipayRootCert.crt           ← 支付宝根证书
ALIPAY_PRIVATE_KEY_PATH=certs/alipay/app_private_key.pem
ALIPAY_APP_CERT_PATH=certs/alipay/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=certs/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=certs/alipay/alipayRootCert.crt

# 也可用环境变量内联内容（优先用上面的 PATH；PATH 为空时才读这些）
# ALIPAY_PRIVATE_KEY=
# ALIPAY_APP_CERT=
# ALIPAY_PUBLIC_CERT=
# ALIPAY_ROOT_CERT=

ALIPAY_NOTIFY_URL=https://city-index.cn/dashboard/api/alipay/notify/
ALIPAY_RETURN_URL=https://city-index.cn/landing/pricing/?pay=return
ORDER_PAY_TIMEOUT_MINUTES=30

# Mock 联调（ALIPAY_MOCK=true）时，支付成功可 POST：
#   /dashboard/api/alipay/mock-notify/
#   Body: {"order_no": "ORD..."}

# ========== 企查查企业二要素核验（机构用户认证） ==========
# 开放平台 https://openapi.qcc.com/dataApi/855 申请开通 ApiCode 855
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
# true=未配置密钥时 Mock；正式环境改为 false 并填写密钥
# Mock 下信用代码以 MOCK 开头 + 任意单位名称可核验通过
QICHACHA_MOCK=true
